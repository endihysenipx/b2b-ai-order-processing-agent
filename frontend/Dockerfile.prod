FROM node:22-alpine AS build

WORKDIR /app

COPY package*.json ./
RUN npm ci

COPY . .

ARG VITE_API_BASE_URL=/api/v1
ENV VITE_API_BASE_URL=${VITE_API_BASE_URL}

RUN npm run build

FROM nginx:1.27-alpine

COPY nginx.prod.conf /etc/nginx/templates/order-agent-http.conf
COPY nginx.https.conf /etc/nginx/templates/order-agent-https.conf
COPY select-nginx-config.sh /docker-entrypoint.d/40-select-order-agent-config.sh
RUN chmod +x /docker-entrypoint.d/40-select-order-agent-config.sh
COPY --from=build /app/dist /usr/share/nginx/html

EXPOSE 80
EXPOSE 443

HEALTHCHECK --interval=30s --timeout=5s --start-period=10s --retries=3 \
  CMD wget -q --spider http://127.0.0.1/healthz || exit 1

CMD ["nginx", "-g", "daemon off;"]
