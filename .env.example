APP_ENV=development
SECRET_KEY=change-me
ACCESS_TOKEN_EXPIRE_MINUTES=60

POSTGRES_DB=order_agent
POSTGRES_USER=order_agent
POSTGRES_PASSWORD=change-me
DATABASE_URL=postgresql+psycopg://order_agent:change-me@postgres:5432/order_agent
SEED_DEMO_DATA=false

OPENAI_API_KEY=
OPENAI_MODEL=

MICROSOFT_TENANT_ID=
MICROSOFT_CLIENT_ID=
MICROSOFT_CLIENT_SECRET=
MICROSOFT_MAILBOX=

STORAGE_ROOT=/app/storage

AWS_REGION=eu-central-1
AWS_BEARER_TOKEN_BEDROCK=
AWS_S3_BUCKET=your-private-order-documents-bucket
TEXTRACT_AUTO_PROCESSING_ENABLED=false
TEXTRACT_POLL_INTERVAL_SECONDS=15
TEXTRACT_MAX_JOBS_PER_POLL=20
AI_PROVIDER=mock
BEDROCK_MODEL_ID=
BEDROCK_MAX_TOKENS=4096
BEDROCK_TEMPERATURE=0

# Gmail receives mail through IMAP. SMTP values are reserved for future replies.
GMAIL_INGESTION_ENABLED=false
GMAIL_IMAP_HOST=imap.gmail.com
GMAIL_IMAP_PORT=993
GMAIL_SMTP_HOST=smtp.gmail.com
GMAIL_SMTP_PORT=587
GMAIL_USERNAME=
GMAIL_APP_PASSWORD=
GMAIL_IMAP_FOLDER=INBOX
GMAIL_SEARCH_CRITERIA=UNSEEN
GMAIL_POLL_INTERVAL_SECONDS=60
GMAIL_MAX_MESSAGES_PER_POLL=25
GMAIL_MARK_AS_READ=true

FRONTEND_URL=http://localhost:5173
VITE_API_BASE_URL=http://localhost:8000/api/v1
